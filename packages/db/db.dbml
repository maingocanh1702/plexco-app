  created_at timestamptz [not null]
}

Table outbox_events {
  id uuid [pk]
  tenant_id uuid [not null]
  aggregate_type text [not null]
  aggregate_id uuid [not null]
  sequence integer [not null]
  type text [not null]
  schema_version integer [not null]
  payload jsonb [not null]
  created_at timestamptz [not null]
  claimed_at timestamptz
}

Table projector_deliveries {
  event_id uuid [not null]
  projector text [not null]
  status text [not null]
  attempts integer [not null]
  next_attempt_at timestamptz
  delivered_at timestamptz
  provider_ref text
  error_code text
}

// 0056: durable projector registry (GLOBAL, job_definer-owned, reached only through definers).
Table outbox_projectors {
  name text [pk]
  enabled boolean [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}

// 0056: event_type NULL = every event of the aggregate (web_realtime only).
Table outbox_projector_routes {
  projector text [not null]
  aggregate_type text [not null]
  event_type text
  created_at timestamptz [not null]
}

// 0057: per-recipient zalo_dm dispositions (GLOBAL, job_definer-owned, reached only through definers).
Table zalo_dm_recipient_deliveries {
  event_id uuid [not null]
  channel_identity_id uuid [not null]
  outcome text [not null]
  error_code text
  created_at timestamptz [not null]
}

Table surface_refs {
  id uuid [pk]
  aggregate_id uuid [not null]
  platform text [not null]
  target text [not null]
  external_ref text
}

Table public_sessions {
  id uuid [pk]
  session_id uuid [not null]
  tenant_id uuid [not null]
  sport_key text [not null]
  starts_at timestamptz [not null]
  ends_at timestamptz [not null]
  area text [not null]
  skill_level text
  price_amount integer [not null]
  slots_open integer [not null]
  club_display_name text [not null]
  host_display_name text
  join_policy text [not null]
  projected_at timestamptz [not null]
  expires_at timestamptz [not null]
  public_projection_version bigint [not null, default: 0, note: '0033 — control metadata (non-PII), whitelist-exception DD-73/DD-78']
  Note: '0033: base SELECT REVOKED khỏi readonly + app; consumer chỉ đọc qua guarded view public_session_share_v (security_barrier, anti-join fence). CHECK id = session_id.'
}

Table public_projection_fences {
  surface text [pk, note: "'session_share' (slice này) | 'activity_card' (sau)"]
  target_kind text [pk, note: "'session' | 'activity_share' | 'person' | 'tenant'"]
  target_id uuid [pk]
  fence_token uuid [not null, note: 'random; projector CAS-clear; không trả về/log']
  deny_scope text [not null, note: "CHECK IN ('public','all')"]
  reason text [not null]
  created_at timestamptz [not null]
  Note: 'GLOBAL PROTECTED, denial-only (DD-12 8a, migration 0033) — không RLS, zero grant cho app/readonly; mọi truy cập qua narrow SECURITY DEFINER fn: raise_public_session_fence (app) · current_public_session_fence_token / clear_public_session_fence (app_worker)'
}

Table join_requests {
  id uuid [pk]
  tenant_id uuid [not null]
