{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_ap3_note": "Writer contract (DESIGN §4, as corrected by W1-DECISION-codex-sandbox.md). The writer does CODING only inside the sandbox; the dispatcher runs the Codex review + push + PR unsandboxed, because codex cannot initialize inside Seatbelt. So the writer needs no openai domains and no gh/codex/push rules.",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [],
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org"
      ]
    },
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.gnupg", "~/.ap-watch.env", "~/.codex", "**/.env", "**/.env.*", "**/.envrc"]
    }
  },
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Glob", "Grep", "Agent",
      "Bash(git *)",
      "Bash(npm test*)", "Bash(npm run *)", "Bash(npx *)",
      "Bash(bash ap3/*)"
    ],
    "deny": [
      "Bash(git push*)", "Bash(git reset --hard*)", "Bash(rm -rf *)",
      "Read(./.env*)", "Read(//**/ap3/env)", "Read(~/.ssh/**)", "Read(~/.aws/**)",
      "WebFetch", "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash ap3/hooks/scope-guard.sh" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "bash ap3/hooks/finish-guard.sh" }] }
    ]
  }
}
