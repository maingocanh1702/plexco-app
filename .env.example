# Plexco — .env.example  (copy → .env; KHÔNG commit .env thật)
# ⚠️ P0 TEMPLATE. Khớp Port Registry + Dependencies (README/TDD §9).
# Prod: KHÔNG dùng .env — set qua App Platform encrypted env/runtime secret store + KMS.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PROCESS_ROLE=web                 # web | discovery | worker
# Trusted client-IP source for application rate limits. Production MUST set
# exactly one provider; DO App Platform = digitalocean, bounded Fly fallback = fly.
# direct is local-only and intentionally ignores all forwarding headers.
# Setting a provider makes the client IP real; before any process serving /api/discover* is exposed beyond local, the in-process discovery limiter MUST be replaced (see the ponytail comment in apps/web/lib/discovery-route-support.ts).
TRUSTED_INGRESS_PROVIDER=direct  # digitalocean | fly | direct
# Dev-login CHỈ local (README §Dev-login): KHÔNG BAO GIỜ bỏ comment dòng dưới ở file env nào —
# chỉ truyền trên dòng lệnh `next dev`. Có mặt (kể cả rỗng) khi NODE_ENV khác development ⇒ app từ chối khởi động.
# PLEXCO_DEV_LOGIN=1

# ── Database ─────────────────────────────────────────────────────────────
# DATABASE_URL        = connection POOLED (transaction-mode) cho web (role app); discovery đọc DB qua DISCOVERY_DATABASE_URL (bên dưới)
# DATABASE_URL_DIRECT = connection DIRECT (session-mode) cho worker/pg-boss (role app_worker)
#                       — pg-boss cần LISTEN/NOTIFY + advisory lock, KHÔNG qua pooler.
# DATABASE_URL_LISTEN = connection DIRECT (session-mode) cho SSE listener trong web (1/replica)
#                       — txn-mode pooler KHÔNG hỗ trợ LISTEN; chỉ dùng để LISTEN, không query.
# Discovery đọc DB qua DISCOVERY_DATABASE_URL (khối DISCOVERY_* bên dưới), KHÔNG qua DATABASE_URL:
# Day-1 trỏ primary bằng role readonly + bounded pool; khi trigger, chỉ đổi endpoint sang read-only node.
# ⚠️ Role `app`, KHÔNG phải superuser plexco (audit 2026-09-06 X-4): web chạy bằng
#    superuser thì RLS vô hình ở dev — mọi lỗi policy chỉ lộ ở test/prod. Role app
#    (migration 0000) có LOGIN nhưng KHÔNG có password cho tới khi set thủ công;
#    lệnh set cả ba role runtime nằm ở khối AP-33 ngay dưới.
#    drizzle-kit (packages/db/drizzle.config.ts: studio/introspect) cũng đọc biến này
#    và sẽ chỉ thấy những gì role app thấy — khi cần nhìn toàn schema, truyền URL owner
#    ad-hoc cho đúng lệnh đó (không sửa file này):
#      DATABASE_URL=postgres://plexco:plexco_dev@localhost:5432/plexco pnpm --filter @plexco/db exec drizzle-kit studio
DATABASE_URL=postgres://app:plexco_dev_app@localhost:5432/plexco
# ⚠️ job-runtime-dispatcher (AP-33): worker.ts giờ chạy preflight fail-closed
#    trước boss.start(), ĐÒI session_user VÀ current_user đều = app_worker
#    (không chấp nhận SET ROLE / connection-string role= từ credential khác —
#    xem apps/bot/src/preflight.ts). KHÔNG kiểm role attributes/CREATE trên
#    pgboss/job_definer membership — least-privilege attestation đó bị loại
#    khỏi scope preflight này (founder decision 2026-07-27, sau round-06 HALT;
#    lý do đầy đủ ở đầu apps/bot/src/preflight.ts). Role app_worker có LOGIN
#    nhưng KHÔNG có password cho tới khi set thủ công.
#    LOCAL LẦN ĐẦU (sau khi đã `pnpm --filter @plexco/db migrate`), set MỘT LẦN
#    cho cả ba role runtime app / app_worker / readonly:
#        docker compose -f infra/docker-compose.yml exec -T postgres \
#          psql -U plexco -d plexco -v ON_ERROR_STOP=1 \
#            -c "ALTER ROLE app        WITH PASSWORD 'plexco_dev_app'" \
#            -c "ALTER ROLE app_worker WITH PASSWORD 'plexco_dev_worker'" \
#            -c "ALTER ROLE readonly   WITH PASSWORD 'plexco_dev_readonly'"
#    (giữ nguyên ba giá trị — khớp DATABASE_URL / DATABASE_URL_DIRECT ở đây và
#    web / worker / discovery trong infra/docker-compose.yml. KHÔNG dùng các
#    password cố định này ở ngoài local dev.)
#    ⚠️ SAU KHI CHẠY BẤT KỲ test nào chạm DB (`pnpm -w test`,
#       `pnpm --filter @plexco/bot test`, `pnpm --filter @plexco/db test`, hay
#       `pnpm --filter @plexco/web test` riêng lẻ): cả ba role là CLUSTER-global,
#       và các suite tự ALTER ROLE sang password RIÊNG của chúng khi chạy
#       (packages/db/src/test-harness.ts: plexco_test_app / plexco_test_readonly;
#       apps/bot + packages/db: app_worker) — KHÔNG suite nào khôi phục lại khi
#       xong (một lần thử tự khôi phục trong apps/bot's test đã bị revert: nó tạo
#       race sống với connection pool của file test khác đang chạy song song, còn
#       tệ hơn vấn đề nó định sửa). Chạy lại đúng lệnh ALTER ROLE ở trên MỖI LẦN
#       sau khi test xong, trước khi start service local lần nữa.
DATABASE_URL_DIRECT=postgres://app_worker:plexco_dev_worker@localhost:5432/plexco
# DATABASE_URL_LISTEN: chưa có code nào đọc (grep process.env 2026-09-06); khi SSE
# listener land, nó chạy bằng role app như web — không bao giờ bằng superuser.
DATABASE_URL_LISTEN=postgres://app:plexco_dev_app@localhost:5432/plexco
# DISCOVERY_DATABASE_URL = readonly role DSN for the public discovery read, in BOTH web and discovery.
DISCOVERY_DATABASE_URL=postgres://readonly:plexco_dev_readonly@localhost:5432/plexco
# DISCOVERY_CURSOR_KEY=   # >= 32 chars, required in production; unset in dev = random key per process
# DATABASE_URL_TEST  = DB riêng cho test suite (CI dùng service postgres; local dùng DB *_test).
#                      pnpm -w test đọc biến này — KHÔNG bao giờ trỏ vào DB dev/prod.
#                      ⚠️ LOCAL LẦN ĐẦU: DB `plexco_test` chưa tồn tại → `pnpm -w test` fail
#                         'database "plexco_test" does not exist'. Tạo trước MỘT LẦN:
#                             createdb -h localhost -U plexco plexco_test
#                         (hoặc: psql -h localhost -U plexco -c 'CREATE DATABASE plexco_test;')
#                         Migrations tự apply khi test khởi động. GIỮ DB test tách khỏi dev/prod.
DATABASE_URL_TEST=postgres://plexco:plexco_dev@localhost:5432/plexco_test
# ⚠️ DATABASE_URL_MIGRATION (role migration/owner, DDL) KHÔNG đặt trong file này:
#    compose nạp .env vào web/worker runtime → lộ DDL credential vào runtime env.
#    Chỉ truyền ad-hoc cho tooling một-lần (migrations + provision:queue), vd:
#    docker compose -f infra/docker-compose.yml run --rm \
#      -e DATABASE_URL_MIGRATION=postgres://... worker provision
# Cờ lịch outbox dispatch. Default commit = true (B3, DD-141; thay DD-134 (e) chỉ cho default commit này).
# Worker chỉ lên lịch khi cờ đúng chuỗi "true" (mọi giá trị khác, kể cả để trống, là tắt, fail-closed:
# xem isOutboxDispatchScheduleEnabled trong apps/bot/src/worker.ts), bản đồ projector không chứa
# productionStubDeliver, VÀ probe registry qua (migration 0056 đã áp dụng); không thì worker log
# "outbox dispatch schedule OFF" kèm lý do.
# "true" KHÔNG có nghĩa là đã gửi: projector seed tắt hết (migration 0056) nên event chỉ được ack với '{}'
# cho tới khi owner bật projector trong registry (docs/runbooks/outbox-dispatch-enable-rollback.md).
# Bật dùng thật là bước P0 của owner: deliverer Zalo thật, token bot Zalo thật, bật projector trong registry.
OUTBOX_DISPATCH_SCHEDULE_ENABLED=true
# Worker liveness (0041, apps/bot/src/heartbeat.ts): mỗi 30s ghi DB heartbeat rồi chạm file;
# Dockerfile HEALTHCHECK của worker đo tuổi file (< 90s). Cả hai tuỳ chọn.
# WORKER_HEARTBEAT_FILE=/tmp/plexco-worker-heartbeat
# WORKER_ID=                         # mặc định = hostname container/machine


# ── Auth target DD-13/DD-37 ──────────────────────────────────────────────
# Web login = Google OAuth (D1 order-3: /api/auth/google/{state,callback} CONSUME
# hai biến dưới) + email/password (order-4, flag OFF). Prod set qua secret manager.
# d1b đã land qua migration 0018 và Safari macOS+iOS M3 measured PASS 2026-07-26:
# engineering/measurement blocker đã đóng. Template vẫn cố ý để rỗng; chỉ set qua
# secret manager sau owner go-live và các gate độc lập (A3 legal/PII/config).
# Repo/template không phải bằng chứng Google login đã được enable ở environment nào.
# Chi tiết: docs/features/BE/feature_web_auth_onboarding_tech.md §4 Session Security.
GOOGLE_OAUTH_CLIENT_ID=             # Google Cloud Console → OAuth 2.0 Client ID
GOOGLE_OAUTH_CLIENT_SECRET=         # KHÔNG commit; prod set qua secret manager
# Fixed app origin (HTTPS ở prod) — Google redirect_uri = ${APP_BASE_URL}/api/auth/google/callback
# (đăng ký ĐÚNG URL này trong Google console) và cũng là post-login redirect target.
# KHÔNG bao giờ suy ra từ Host header (§8.4). Dev default:
APP_BASE_URL=http://localhost:3000

# ── Facebook App + Messenger (DD-33/DD-37 — kênh phase-1, cần Meta App Review) ─
# 1 Meta App: FB Login (account-link, DD-33) + Messenger Platform (kênh player).
FACEBOOK_APP_ID=                    # Meta App ID
FACEBOOK_APP_SECRET=                # App Secret (dùng cho FB Login + verify Messenger webhook)
MESSENGER_PAGE_ACCESS_TOKEN=        # Page access token (per-club nếu nhiều Page)
MESSENGER_VERIFY_TOKEN=             # verify webhook subscription (GET hub.challenge)
MESSENGER_APP_SECRET=               # HMAC X-Hub-Signature-256 (= FACEBOOK_APP_SECRET; tách nếu App khác)

# ── Zalo (BYO bot per-club) ──────────────────────────────────────────────
# Token mỗi club nhập khi onboarding → lưu zalo_bots.webhook_token (mã hoá KMS).
# Verify header: X-Bot-Api-Secret-Token (timing-safe).

# ── SePay / ApiPay (webhook đối soát CK, per-bank token) ─────────────────
SEPAY_WEBHOOK_SECRET=               # verify Apikey (timing-safe) + verify account

# ── Secrets / KMS (mã hoá at-rest token & webhook secret) ────────────────
# Prod: dùng KMS thật (envelope AES-GCM). Dev có thể để key local.
KMS_PROVIDER=local                  # local | aws-kms | gcp-kms | ...
KMS_KEY_ID=
ENCRYPTION_KEY=                     # dev-only fallback (KHÔNG dùng ở prod)
# KMS_ENCRYPTED_AUTH_PEPPER (DD-31 gap 3, aws-kms only): base64 ciphertext blob
# from ONE-TIME `aws kms encrypt` on a random 32-byte value with KMS_KEY_ID.
# Decrypted at boot (deterministic), cached — the shared pepper for keyed
# auth-surface hashes (SI-2's account_identities.platform_user_hash today).
KMS_ENCRYPTED_AUTH_PEPPER=
# AWS_REGION (aws-kms only, REQUIRED): AWS SDK v3 does not infer the region
# from the key ARN — without this, Decrypt fails "Region is missing" and
# every auth login 500s (auth-surface hash decrypt fails; codex auth-onboarding-v3 round-13).
AWS_REGION=
# KMS_ENCRYPTED_CONNECTOR_PEPPER (M3a, DD-122 O4, aws-kms only, OPTIONAL): separate root for Zalo connector
# secrets (bot token, webhook secret, raw inbound events). Unset -> derived from the auth secret with a
# connector-specific HKDF label. Same one-time `aws kms encrypt` procedure as the auth pepper.
KMS_ENCRYPTED_CONNECTOR_PEPPER=
# ZALO_BOT_API_BASE (M3a): Zalo Bot API origin; default https://bot-api.zaloplatforms.com
ZALO_BOT_API_BASE=
# LINK_CODE_LOOKUP_HMAC_KEY (M3a/M3b): BASE64 decoding to >= 32 bytes -- generate with
# `openssl rand -base64 32`. Missing/short -> Zalo /link replies "temporarily unavailable".
# The web consume lane (M3b) MUST use the same value and decoder (apps/web/lib/link-code-keys.ts).
LINK_CODE_LOOKUP_HMAC_KEY=

# ── Web session ──────────────────────────────────────────────────────────
SESSION_SECRET=                     # auto-rotate 30d ở prod (security-ops §4)

# ── Runtime guards (audit 2026-09-06) ────────────────────────────────────
# DB_EXPECTED_ROLE: web/discovery assert `current_user`/`session_user` on first DB use and
# fail closed on mismatch (W-10, apps/web/lib/session-cookies.ts). Compose set app/readonly;
# để trống = không kiểm (test, tooling). KHÔNG set cho worker (preflight riêng, apps/bot).
DB_EXPECTED_ROLE=app
# CSP_SCRIPT_NONCE_ENABLED: chỉ chuỗi "true" bật CSP `script-src 'nonce-…'` per-request qua
# apps/web/middleware.ts (row web-csp-script-src-nonce). OFF cho tới khi verify trên `next start`
# thật + console trình duyệt 0 CSP violation — bật mù là vỡ mọi trang.
CSP_SCRIPT_NONCE_ENABLED=false
# Chỉ đúng chuỗi "true" bật thu thập giới tính (apps/web/app/api/me/profile/route.ts:32); default commit = true (B3, DD-141).
# Thông báo mục đích (components/me/settings-profile-form.tsx) và ghi chú riêng tư (components/me/settings-privacy-note.tsx) hiển thị ở /me/settings khi cờ bật.
GENDER_COLLECTION_ENABLED=true

# ── Observability (tuỳ chọn) ─────────────────────────────────────────────
SENTRY_DSN=                         # chưa có reader (row observability-sentry-loglevel-readers)
LOG_LEVEL=debug                     # error|warn|info|debug — reader: apps/web/lib/log.ts (redact theo tên key; giá trị lạ = info); prod: info

# ── Dev tools ────────────────────────────────────────────────────────────
DRIZZLE_STUDIO_PORT=4983            # dev only
