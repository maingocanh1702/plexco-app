# Plexco — .env.example  (copy → .env; KHÔNG commit .env thật)
# ⚠️ P0 TEMPLATE. Khớp Port Registry + Dependencies (README/TDD §9).
# Prod: KHÔNG dùng .env — set qua App Platform encrypted env/runtime secret store + KMS.

# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PROCESS_ROLE=web                 # web | discovery | worker
# Trusted client-IP source for application rate limits. Production MUST set
# exactly one provider; DO App Platform = digitalocean, bounded Fly fallback = fly.
# direct is local-only and intentionally ignores all forwarding headers.
TRUSTED_INGRESS_PROVIDER=direct  # digitalocean | fly | direct

# ── Database ─────────────────────────────────────────────────────────────
# DATABASE_URL        = connection POOLED (transaction-mode) cho web/discovery (role app/readonly)
# DATABASE_URL_DIRECT = connection DIRECT (session-mode) cho worker/pg-boss (role app_worker)
#                       — pg-boss cần LISTEN/NOTIFY + advisory lock, KHÔNG qua pooler.
# DATABASE_URL_LISTEN = connection DIRECT (session-mode) cho SSE listener trong web (1/replica)
#                       — txn-mode pooler KHÔNG hỗ trợ LISTEN; chỉ dùng để LISTEN, không query.
# Discovery cũng dùng tên DATABASE_URL, nhưng credential/endpoint được scope riêng cho component:
# Day-1 trỏ primary bằng role readonly + bounded pool; khi trigger, chỉ đổi endpoint sang read-only node.
DATABASE_URL=postgres://plexco:plexco_dev@localhost:5432/plexco
DATABASE_URL_DIRECT=postgres://plexco:plexco_dev@localhost:5432/plexco
DATABASE_URL_LISTEN=postgres://plexco:plexco_dev@localhost:5432/plexco
# DATABASE_URL_TEST  = DB riêng cho test suite (CI dùng service postgres; local dùng DB *_test).
#                      pnpm -w test đọc biến này — KHÔNG bao giờ trỏ vào DB dev/prod.
#                      ⚠️ LOCAL LẦN ĐẦU: DB `plexco_test` chưa tồn tại → `pnpm -w test` fail
#                         'database "plexco_test" does not exist'. Tạo trước MỘT LẦN:
#                             createdb -h localhost -U plexco plexco_test
#                         (hoặc: psql -h localhost -U plexco -c 'CREATE DATABASE plexco_test;')
#                         Migrations tự apply khi test khởi động. GIỮ DB test tách khỏi dev/prod.
DATABASE_URL_TEST=postgres://plexco:plexco_dev@localhost:5432/plexco_test
# ⚠️ DATABASE_URL_MIGRATION (role migration/owner, DDL) KHÔNG đặt trong file này:
#    compose nạp .env vào web/worker runtime → lộ DDL credential vào runtime env.
#    Chỉ truyền ad-hoc cho tooling một-lần (migrations + provision:queue), vd:
#    docker compose -f infra/docker-compose.yml run --rm \
#      -e DATABASE_URL_MIGRATION=postgres://... worker provision

# ── Auth hiện tại trên HEAD (Auth v3 Telegram-era) ────────────────────────
# TẠM THỜI bắt buộc cho /api/auth/telegram/callback. Xóa biến này chỉ sau khi
# Google/email provider replacement (DD-13/DD-37) đã land và route Telegram bị gỡ.
TELEGRAM_BOT_TOKEN=

# ── Auth target DD-13/DD-37 ──────────────────────────────────────────────
# Web login = Google OAuth (D1 order-3: /api/auth/google/{state,callback} CONSUME
# hai biến dưới) + email/password (order-4, flag OFF). Prod set qua secret manager.
# ⚠️ ENABLEMENT BLOCKER: KHÔNG set hai biến dưới ở BẤT KỲ environment nào cho tới khi
#    slice `auth-s4-d1b-oauth-session-rotation` đã land. Callback cross-site KHÔNG
#    thấy cookie Strict plx_session nên KHÔNG rotate/revoke được session cũ → session
#    trước-login SỐNG SÓT sau khi login Google (residual risk). Chi tiết:
#    docs/features/BE/feature_web_auth_onboarding_tech.md §4 Session Security.
GOOGLE_OAUTH_CLIENT_ID=             # Google Cloud Console → OAuth 2.0 Client ID
GOOGLE_OAUTH_CLIENT_SECRET=         # KHÔNG commit; prod set qua secret manager
# Fixed app origin (HTTPS ở prod) — Google redirect_uri = ${APP_BASE_URL}/api/auth/google/callback
# (đăng ký ĐÚNG URL này trong Google console) và cũng là post-login redirect target.
# KHÔNG bao giờ suy ra từ Host header (§8.4). Dev default:
APP_BASE_URL=http://localhost:3000

# ── Facebook App + Messenger (DD-33/DD-37 — kênh phase-1, cần Meta App Review) ─
# 1 Meta App: FB Login (account-link, DD-33) + Messenger Platform (kênh player).
FACEBOOK_APP_ID=                    # Meta App ID
FACEBOOK_APP_SECRET=                # App Secret (dùng cho FB Login + verify Messenger webhook)
MESSENGER_PAGE_ACCESS_TOKEN=        # Page access token (per-club nếu nhiều Page)
MESSENGER_VERIFY_TOKEN=             # verify webhook subscription (GET hub.challenge)
MESSENGER_APP_SECRET=               # HMAC X-Hub-Signature-256 (= FACEBOOK_APP_SECRET; tách nếu App khác)

# ── Zalo (BYO bot per-club) ──────────────────────────────────────────────
# Token mỗi club nhập khi onboarding → lưu zalo_bots.webhook_token (mã hoá KMS).
# Verify header: X-Bot-Api-Secret-Token (timing-safe).

# ── SePay / ApiPay (webhook đối soát CK, per-bank token) ─────────────────
SEPAY_WEBHOOK_SECRET=               # verify Apikey (timing-safe) + verify account

# ── Secrets / KMS (mã hoá at-rest token & webhook secret) ────────────────
# Prod: dùng KMS thật (envelope AES-GCM). Dev có thể để key local.
KMS_PROVIDER=local                  # local | aws-kms | gcp-kms | ...
KMS_KEY_ID=
ENCRYPTION_KEY=                     # dev-only fallback (KHÔNG dùng ở prod)
# KMS_ENCRYPTED_AUTH_PEPPER (DD-31 gap 3, aws-kms only): base64 ciphertext blob
# from ONE-TIME `aws kms encrypt` on a random 32-byte value with KMS_KEY_ID.
# Decrypted at boot (deterministic), cached — the shared pepper for keyed
# auth-surface hashes (SI-2's account_identities.platform_user_hash today).
KMS_ENCRYPTED_AUTH_PEPPER=
# AWS_REGION (aws-kms only, REQUIRED): AWS SDK v3 does not infer the region
# from the key ARN — without this, Decrypt fails "Region is missing" and
# every auth login 500s (auth-surface hash decrypt fails; codex auth-onboarding-v3 round-13).
AWS_REGION=

# ── Web session ──────────────────────────────────────────────────────────
SESSION_SECRET=                     # auto-rotate 30d ở prod (security-ops §4)

# ── Observability (tuỳ chọn) ─────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug                     # prod: info; log gắn tenant_id, KHÔNG secret/PII

# ── Dev tools ────────────────────────────────────────────────────────────
DRIZZLE_STUDIO_PORT=4983            # dev only
