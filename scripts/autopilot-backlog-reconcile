#!/usr/bin/env bash
# autopilot-backlog-reconcile — derive backlog merged-status from CODE (ground truth), not the hand-typed field.
#
# WHY: backlog `status:` is hand-maintained; merges update INFLIGHT + code but the markdown field rots
#   ("ready/planned" while already merged → wasted re-run, L24). This makes the field self-correcting.
#
# HOW: each task block carries a `merged_probe:` line = a symbol that exists on the default branch ONLY if
#   the feature is merged. Probe format (safe, no eval):
#     merged_probe: <file> :: <grep -E regex>
#   e.g.  merged_probe: src/gendered-fee-core.ts :: sessionFeeTotals
#   The script greps the WORKING TREE (assumes you're on/synced with the default branch). Probe passes ⇒ merged.
#
# Usage:
#   scripts/autopilot-backlog-reconcile            # REPORT: which planned/ready/blocked tasks are actually merged
#   scripts/autopilot-backlog-reconcile --fix      # FLIP those tasks' status -> merged (+ note_merged) in place
#   scripts/autopilot-backlog-reconcile --check    # exit 1 if any stale (CI / watchdog / pre-commit gate)
#
# A task with NO merged_probe is reported as "no-probe" (can't auto-verify) — add one when you author it.
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BL="$REPO/docs/autopilot-backlog.md"
[ -f "$BL" ] || { echo "HALT: backlog not found at $BL" >&2; exit 2; }
MODE="${1:-report}"

# Parse blocks → emit "slug<TAB>status<TAB>probe_file<TAB>probe_regex" for status in planned|ready|blocked.
mapfile -t ROWS < <(awk '
  function flush(){ if (slug!="" && (st=="planned"||st=="ready"||st=="blocked")) printf "%s\t%s\t%s\t%s\n", slug, st, pf, pr; slug="" }
  /^## task:/ { flush(); slug=$3; gsub(/[()]/,"",slug); st=""; pf=""; pr="" }
  /^status:/  { st=$2 }
  /^merged_probe:/ {
    line=$0; sub(/^merged_probe:[[:space:]]*/,"",line)
    n=split(line, a, /[[:space:]]*::[[:space:]]*/); if(n==2){ pf=a[1]; pr=a[2] }
  }
  END { flush() }
' "$BL")

stale=()
for row in "${ROWS[@]}"; do
  IFS=$'\t' read -r slug st pf pr <<< "$row"
  if [ -z "$pf" ] || [ -z "$pr" ]; then
    echo "  ?  $slug ($st) — no merged_probe (can't auto-verify; add: merged_probe: <file> :: <regex>)"
    continue
  fi
  if [ -f "$REPO/$pf" ] && grep -qE "$pr" "$REPO/$pf" 2>/dev/null; then
    echo "  ⚠ STALE: $slug ($st) — probe MATCHED on disk → already MERGED"
    stale+=("$slug")
  else
    echo "  ✓  $slug ($st) — genuinely pending (probe absent)"
  fi
done

[ "${#stale[@]}" -eq 0 ] && { echo "No stale entries."; [ "$MODE" = "--check" ] && exit 0 || exit 0; }

if [ "$MODE" = "--check" ]; then
  echo "STALE entries exist (${#stale[@]}). Run with --fix." >&2; exit 1
fi
if [ "$MODE" = "--fix" ]; then
  for slug in "${stale[@]}"; do
    awk -v s="$slug" '
      $0 ~ "^## task: "s"([ (]|$)" { inblk=1 }
      inblk && /^status:/ && !done { print "status: merged"; print "note_merged: auto-reconciled — merged_probe matched on disk (" strftime("%Y-%m-%d") "). Was: " $2; done=1; next }
      /^## task:/ && inblk && $3!~s { inblk=0 }
      { print }
    ' "$BL" > "$BL.tmp" && mv "$BL.tmp" "$BL"
    echo "  → flipped $slug → merged"
    # reset done flag handled per-invocation (one awk per slug keeps it simple/correct)
  done
  echo "Done. Review: git diff docs/autopilot-backlog.md"
fi
