diff -ruN base/packages/db/migrations/0014_identity_channel_security.sql cand/packages/db/migrations/0014_identity_channel_security.sql
--- a/packages/db/migrations/0014_identity_channel_security.sql	2026-07-19 01:08:44.740006435 +0700
+++ b/packages/db/migrations/0014_identity_channel_security.sql	2026-07-19 01:08:44.754006435 +0700
@@ -0,0 +1,257 @@
+-- ============================================================================
+-- 0014_identity_channel_security.sql
+-- Security boundary for cross-channel identity linking and channel credentials.
+--
+-- This migration is deliberately fail-closed for pre-runtime connector rows:
+-- raw routing tokens and ambiguously encoded secrets must not be silently
+-- reclassified as keyed hashes / KMS ciphertext. The Zalo/Messenger runtimes
+-- are not implemented on the baseline this migration follows, so a non-empty
+-- connector table means an operator must first perform an explicit secret
+-- migration with the real KMS key and token-HMAC key.
+-- ============================================================================
+
+-- ---- Provider-scoped channel identities -----------------------------------
+-- Messenger PSIDs are page-scoped. Zalo user ids must be treated as bot/OA-
+-- scoped until a provider spike proves a wider stable namespace. Keeping the
+-- scope as a separate keyed hash makes that boundary impossible to omit from
+-- the uniqueness contract.
+ALTER TABLE channel_identities
+  ADD COLUMN provider_scope_lookup_hash text;
+
+DO $$
+BEGIN
+  IF EXISTS (
+    SELECT 1 FROM channel_identities WHERE platform IN ('zalo', 'messenger')
+  ) THEN
+    RAISE EXCEPTION
+      '0014 requires an explicit Page/OA scope backfill for existing Zalo/Messenger identities';
+  END IF;
+END
+$$;
+
+-- Legacy Telegram-era rows used a global namespace. The backfill contains no
+-- provider/user PII; new adapters MUST write a keyed hash of the real scope.
+UPDATE channel_identities
+SET provider_scope_lookup_hash = encode(digest(platform || ':legacy-global', 'sha256'), 'hex')
+WHERE provider_scope_lookup_hash IS NULL AND platform = 'telegram';
+
+ALTER TABLE channel_identities
+  ALTER COLUMN provider_scope_lookup_hash SET NOT NULL,
+  ADD CONSTRAINT channel_identities_scope_hash_chk
+    CHECK (length(provider_scope_lookup_hash) >= 32),
+  ADD CONSTRAINT channel_identities_user_hash_chk
+    CHECK (length(platform_user_lookup_hash) >= 32);
+
+ALTER TABLE channel_identities
+  DROP CONSTRAINT IF EXISTS channel_identities_platform_platform_user_lookup_hash_key;
+DROP INDEX IF EXISTS channel_identities_platform_uid_uq;
+CREATE UNIQUE INDEX channel_identities_platform_scope_uid_uq
+  ON channel_identities(platform, provider_scope_lookup_hash, platform_user_lookup_hash);
+
+-- ---- Link-code issuer and one-way lifecycle --------------------------------
+ALTER TABLE link_codes
+  ALTER COLUMN source_channel_identity_id DROP NOT NULL,
+  ADD COLUMN source_account_id uuid REFERENCES accounts(id),
+  ADD COLUMN max_attempts integer NOT NULL DEFAULT 5,
+  ADD COLUMN locked_until timestamptz,
+  ADD COLUMN revoked_at timestamptz,
+  ADD CONSTRAINT link_codes_one_issuer_chk
+    CHECK (num_nonnulls(source_channel_identity_id, source_account_id) = 1),
+  ADD CONSTRAINT link_codes_action_chk
+    CHECK (action IN ('merge_identity')),
+  ADD CONSTRAINT link_codes_attempts_chk
+    CHECK (failed_attempts >= 0 AND max_attempts BETWEEN 1 AND 10
+           AND failed_attempts <= max_attempts),
+  ADD CONSTRAINT link_codes_hash_material_chk
+    CHECK (length(code_lookup_hash) >= 32
+           AND octet_length(code_hash) >= 32
+           AND octet_length(salt) >= 16),
+  ADD CONSTRAINT link_codes_time_chk
+    CHECK (expires_at > created_at
+           AND (consumed_at IS NULL
+                OR (consumed_at >= created_at AND consumed_at <= expires_at))
+           AND (revoked_at IS NULL OR revoked_at >= created_at)
+           AND (locked_until IS NULL OR locked_until >= created_at)
+           AND NOT (consumed_at IS NOT NULL AND revoked_at IS NOT NULL));
+
+CREATE INDEX idx_link_codes_active_expiry
+  ON link_codes(expires_at)
+  WHERE consumed_at IS NULL AND revoked_at IS NULL;
+
+-- Validate ownership at ISSUE time under a row lock. Do not use a persistent
+-- composite FK here: merge must be able to re-parent the channel/account while
+-- the immutable link-code retains the original issuer evidence.
+CREATE OR REPLACE FUNCTION link_code_issuer_guard()
+RETURNS trigger
+LANGUAGE plpgsql
+SET search_path = pg_catalog, public
+AS $$
+DECLARE
+  issuer_person_id uuid;
+BEGIN
+  -- Let the named CHECK constraint own the both/neither-issuer error.
+  IF num_nonnulls(NEW.source_channel_identity_id, NEW.source_account_id) <> 1 THEN
+    RETURN NEW;
+  END IF;
+
+  -- Identity merge takes person rows before re-parenting account/channel rows.
+  -- Issuance must use the same order or the two transactions can deadlock.
+  PERFORM 1
+  FROM public.persons
+  WHERE id = NEW.source_person_id
+  FOR UPDATE;
+
+  IF NOT FOUND THEN
+    RAISE EXCEPTION USING
+      ERRCODE = '23503',
+      MESSAGE = 'link-code issuer does not belong to source person';
+  END IF;
+
+  IF NEW.source_channel_identity_id IS NOT NULL THEN
+    SELECT person_id INTO issuer_person_id
+    FROM public.channel_identities
+    WHERE id = NEW.source_channel_identity_id
+    FOR UPDATE;
+  ELSE
+    SELECT person_id INTO issuer_person_id
+    FROM public.accounts
+    WHERE id = NEW.source_account_id
+    FOR UPDATE;
+  END IF;
+
+  IF issuer_person_id IS DISTINCT FROM NEW.source_person_id THEN
+    RAISE EXCEPTION USING
+      ERRCODE = '23503',
+      MESSAGE = 'link-code issuer does not belong to source person';
+  END IF;
+  RETURN NEW;
+END
+$$;
+
+CREATE TRIGGER link_code_issuer_guard_trigger
+BEFORE INSERT ON link_codes
+FOR EACH ROW EXECUTE FUNCTION link_code_issuer_guard();
+
+CREATE OR REPLACE FUNCTION link_code_state_guard()
+RETURNS trigger
+LANGUAGE plpgsql
+SET search_path = pg_catalog, public
+AS $$
+BEGIN
+  IF TG_OP = 'DELETE' THEN
+    IF OLD.consumed_at IS NOT NULL OR OLD.revoked_at IS NOT NULL THEN
+      RAISE EXCEPTION 'terminal link-code cannot be deleted';
+    END IF;
+    RETURN OLD;
+  END IF;
+
+  IF NEW.source_person_id IS DISTINCT FROM OLD.source_person_id
+     OR NEW.source_channel_identity_id IS DISTINCT FROM OLD.source_channel_identity_id
+     OR NEW.source_account_id IS DISTINCT FROM OLD.source_account_id
+     OR NEW.code_lookup_hash IS DISTINCT FROM OLD.code_lookup_hash
+     OR NEW.code_hash IS DISTINCT FROM OLD.code_hash
+     OR NEW.salt IS DISTINCT FROM OLD.salt
+     OR NEW.action IS DISTINCT FROM OLD.action
+     OR NEW.expires_at IS DISTINCT FROM OLD.expires_at
+     OR NEW.max_attempts IS DISTINCT FROM OLD.max_attempts
+     OR NEW.created_at IS DISTINCT FROM OLD.created_at THEN
+    RAISE EXCEPTION 'link-code immutable identity fields cannot change';
+  END IF;
+
+  IF (OLD.consumed_at IS NOT NULL OR OLD.revoked_at IS NOT NULL)
+     AND NEW IS DISTINCT FROM OLD THEN
+    RAISE EXCEPTION 'terminal link-code cannot change';
+  END IF;
+  IF NEW.failed_attempts < OLD.failed_attempts THEN
+    RAISE EXCEPTION 'link-code failed attempts cannot decrease';
+  END IF;
+  RETURN NEW;
+END
+$$;
+
+CREATE TRIGGER link_code_state_guard_trigger
+BEFORE UPDATE OR DELETE ON link_codes
+FOR EACH ROW EXECUTE FUNCTION link_code_state_guard();
+
+-- Web-auth identity namespaces are closed. Telegram remains accepted only for
+-- already-merged legacy auth until the provider-swap migration removes it.
+ALTER TABLE account_identities
+  ADD CONSTRAINT account_identities_platform_chk
+  CHECK (platform IN ('telegram','google','email','facebook','zalo'));
+
+-- ---- Connector secret separation ------------------------------------------
+DO $$
+BEGIN
+  IF EXISTS (SELECT 1 FROM zalo_bots) OR EXISTS (SELECT 1 FROM messenger_pages) THEN
+    RAISE EXCEPTION
+      '0014 refuses to reinterpret existing connector credentials; migrate them explicitly with KMS/HMAC first';
+  END IF;
+END
+$$;
+
+DROP INDEX IF EXISTS idx_zalo_bots_webhook_token;
+ALTER TABLE zalo_bots
+  DROP COLUMN bot_token_enc,
+  DROP COLUMN webhook_token,
+  DROP COLUMN secret,
+  ADD COLUMN webhook_token_lookup_hash text NOT NULL,
+  ADD CONSTRAINT zalo_bots_webhook_hash_chk
+    CHECK (length(webhook_token_lookup_hash) >= 32);
+CREATE UNIQUE INDEX idx_zalo_bots_webhook_token_lookup_hash
+  ON zalo_bots(webhook_token_lookup_hash);
+
+CREATE TABLE zalo_bot_secrets (
+  bot_id                     uuid PRIMARY KEY REFERENCES zalo_bots(id) ON DELETE CASCADE,
+  bot_token_enc              bytea NOT NULL,
+  webhook_secret_enc         bytea,
+  kms_key_version            text NOT NULL,
+  pending_bot_token_enc      bytea,
+  pending_webhook_secret_enc bytea,
+  pending_kms_key_version    text,
+  pending_created_at         timestamptz,
+  created_at                 timestamptz NOT NULL DEFAULT now(),
+  rotated_at                 timestamptz,
+  CONSTRAINT zalo_bot_secrets_current_chk
+    CHECK (octet_length(bot_token_enc) > 0
+      AND length(kms_key_version) > 0
+      AND (webhook_secret_enc IS NULL OR octet_length(webhook_secret_enc) > 0)),
+  CONSTRAINT zalo_bot_secrets_pending_chk
+    CHECK (
+      (pending_bot_token_enc IS NULL
+        AND pending_webhook_secret_enc IS NULL
+        AND pending_kms_key_version IS NULL
+        AND pending_created_at IS NULL)
+      OR
+      (pending_bot_token_enc IS NOT NULL
+        AND pending_kms_key_version IS NOT NULL
+        AND pending_created_at IS NOT NULL
+        AND octet_length(pending_bot_token_enc) > 0
+        AND length(pending_kms_key_version) > 0
+        AND (pending_webhook_secret_enc IS NULL
+          OR octet_length(pending_webhook_secret_enc) > 0))
+    )
+);
+
+ALTER TABLE messenger_pages
+  DROP COLUMN page_token_enc,
+  DROP COLUMN app_secret_enc;
+
+CREATE TABLE messenger_page_secrets (
+  page_id         uuid PRIMARY KEY REFERENCES messenger_pages(id) ON DELETE CASCADE,
+  page_token_enc  bytea NOT NULL,
+  kms_key_version text NOT NULL,
+  created_at      timestamptz NOT NULL DEFAULT now(),
+  rotated_at      timestamptz
+);
+
+-- These tables are GLOBAL protected, not tenant-RLS metadata. Runtime roles
+-- receive no table access; future ingress uses narrow audited functions. The
+-- Facebook App Secret is platform-global and remains outside Postgres in the
+-- deployment secret manager.
+REVOKE ALL ON zalo_bot_secrets, messenger_page_secrets
+  FROM PUBLIC, app, app_worker, readonly;
+
+COMMENT ON TABLE zalo_bot_secrets IS
+  'GLOBAL protected; current plus durable pending Zalo credentials. Optional webhook secret remains provider-contract gated. No runtime table grants.';
+COMMENT ON TABLE messenger_page_secrets IS
+  'GLOBAL protected; Page token only. Facebook App Secret belongs in the platform secret manager.';
