{
  "name": "plexco",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm run test:review-readiness && pnpm -r run test",
    "test:review-readiness": "node --test scripts/check-review-readiness.test.mjs",
    "review:check": "node scripts/check-review-readiness.mjs --all",
    "review:check:changed": "node scripts/check-review-readiness.mjs --changed",
    "build": "pnpm -r run typecheck && pnpm -r run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:bootstrap": "psql \"${DATABASE_URL_MIGRATION:?DATABASE_URL_MIGRATION is required}\" -v ON_ERROR_STOP=1 -c \"SET job_definer_bootstrap.migration_role = '${MIGRATION_ROLE:-}'\" -f infra/postgres-init/01-job-definer.sql"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "15.5.20",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.16",
      "sharp": "^0.35.0",
      "postcss": "^8.5.10"
    }
  }
}
